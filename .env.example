# Predicta - Template de variables de entorno para automatización de apuestas
# Copiar a .env y rellenar con tus credenciales

# ==============================================
# DATABASE - PostgreSQL
# ==============================================
DATABASE_URL=postgres://user:password@localhost/predicta

# ==============================================
# MATCHBOOK - Configuración principal (RECOMENDADA)
# ==============================================
# 1. Crear cuenta en https://matchbook.com
# 2. Completar KYC y depositar fondos
# 3. Usar credenciales aquí (más seguro que Betfair)
MATCHBOOK_USERNAME=tu_email_matchbook
MATCHBOOK_PASSWORD=tu_contraseña_matchbook

# ==============================================
# BETFAIR - Configuración alternativa
# ==============================================
# Crea cuenta en https://developer.betfair.com/
# Genera Application Key en 'My Account' → 'Application Keys'
BETFAIR_USERNAME=tu_email_betfair
# La misma contraseña que usas en betfair.com
BETFAIR_PASSWORD=tu_contraseña_betfair
# Application Key del dashboard de developer
BETFAIR_APP_KEY=tu_application_key_aquí

# Sandbox (pruebas) o Producción
# True: sandbox (sin dinero real, sin certificados SSL) - Para desarrollo
# False: producción (dinero real, requiere certificados SSL) - Para live
BETFAIR_SANDBOX=False

# ==============================================
# BETFAIR - Certificados SSL robot login (producción)
# ==============================================
# Directorio con certificados SSL para robot login
# SOLO necesario si BETFAIR_SANDBOX=False
BETFAIR_CERT_DIR=/etc/betfair/certs/
# Ruta específica al certificado público (crt)
BETFAIR_CERT_PATH=/etc/betfair/certs/client-2048.crt
# Ruta específica a la clave privada (key)
BETFAIR_KEY_PATH=/etc/betfair/certs/client-2048.key

# ==============================================
# ODDS API - Partidos próximos
# ==============================================
# Register at https://the-odds-api.com/
# La API key está configurada en settings.py, pero puedes sobrescribir aquí
ODDS_API_KEY=9c2c101074ae4a4c3ec9b01a4d38cb6a

# ==============================================
# PREDICCIONES - Configuración del bot
# ==============================================
# Margen mínimo para colocar apuesta (edge %)
# Ejemplo: 0.05 = 5% edge (probabilidad modelo > cuota Betfair en 5%)
BETTING_MIN_EDGE=0.05

# Stake máximo por apuesta (en USD)
BETTING_MAX_STAKE=10.0

# Stake como porcentaje del balance disponible
# Ejemplo: 0.02 = 2% del balance
BETTING_STAKE_PERCENTAGE=0.02

# ==============================================
# MONITORING Y LOGS
# ==============================================
# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Habilitar/deshabilitar logs detallados de Betfair
BETFAIR_VERBOSE_LOGS=False

# Telegram webhook para alertas (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================
# SEGURIDAD
# ==============================================
# Secret key de Django (genera una nueva)
DJANGO_SECRET_KEY='genera-una-clave-secreta-larga-y-aleatoria-aquí'

# ==============================================
# REDIS (para cache y colas - opcional)
# ==============================================
REDIS_URL=redis://localhost:6379/0